{
  "enabled": true,
  "includeUnknown": true,
  "allowedPackageIds": [],
  "blockedPackageIds": [],
  "packageRules": [
    {
      "id": "OpenJS.NodeJS",
      "mode": "ManualOnly",
      "allowMajorVersion": false,
      "processNames": [
        "node.exe"
      ]
    }
  ],
  "maxRetries": 2,
  "retryableInstallerExitCodes": [
    1618
  ],
  "maxRunMinutes": 120,
  "maintenanceWindow": {
    "enabled": false,
    "start": "02:00",
    "end": "04:00"
  },
  "rebootPolicy": "ReportOnly",
  "wazuhReporting": {
    "eventLog": true,
    "jsonl": true
  },
  "wingetSourceRepair": true,
  "logRetentionDays": 30
}
